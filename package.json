{
  "name": "echoes-player",
  "version": "5.4.0",
  "license": "MIT",
  "scripts": {
    "ng": "node --openssl-legacy-provider ./scripts/run-ng.js",
    "start": "node --openssl-legacy-provider ./scripts/run-ng.js serve",
    "start:integration": "node --openssl-legacy-provider ./scripts/run-ng.js serve --configuration=integration",
    "build": "node --openssl-legacy-provider ./scripts/run-ng.js build",
    "build:prod": "node --openssl-legacy-provider ./scripts/run-ng.js build --prod",
    "build:integration": "node --openssl-legacy-provider ./scripts/run-ng.js build --configuration=integration",
    "build:env": "node config/build-env.js",
    "copy:homepage": "shx cp -r ./config/homepage/ ./dist/",
    "copy:license": "shx cp LICENSE.md ./dist/assets",
    "copy:package": "shx cp ./package.json ./dist/assets/",
    "test": "node --openssl-legacy-provider ./scripts/run-ng.js test --watch",
    "test:ci": "node --openssl-legacy-provider ./scripts/run-ng.js test",
    "lint": "node --openssl-legacy-provider ./scripts/run-ng.js lint",
    "lint:fix": "prettier --write ./src/**/*.ts",
    "e2e": "node --openssl-legacy-provider ./scripts/run-ng.js e2e",
    "clean": "rimraf -- node_modules",
    "server:prod": "http-server ./dist -a localhost -p 4200"
  },
  "private": true,
  "overrides": {
    "websocket-driver": "^0.7.4"
  },
  "dependencies": {
    "@angular-devkit/core": "^9.0.0",
    "@angular/animations": "^9.0.0",
    "@angular/cdk": "^9.0.0",
    "@angular/common": "^9.0.0",
    "@angular/compiler": "^9.0.0",
    "@angular/core": "^9.0.0",
    "@angular/forms": "^9.0.0",
    "@angular/platform-browser": "^9.0.0",
    "@angular/platform-browser-dynamic": "^9.0.0",
    "@angular/router": "^9.0.0",
    "@angular/service-worker": "^9.0.0",
    "http-server": "0.10.0",
    "memo-decorator": "1.0.2",
    "replace": "0.3.0",
    "rxjs": "6.5.5",
    "sass": "^1.77.0",
    "service-worker": "0.0.0",
    "tslib": "^1.0.0",
    "zone.js": "~0.10.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^0.901.15",
    "@angular/cli": "^9.0.0",
    "@angular/compiler-cli": "^9.0.0",
    "@angular/language-service": "^9.0.0",
    "@fortawesome/fontawesome-free": "5.4.2",
    "@ngrx/effects": "^9.0.0",
    "@ngrx/router-store": "^9.0.0",
    "@ngrx/store": "^9.0.0",
    "@ngrx/store-devtools": "^9.0.0",
    "@types/gapi": "0.0.35",
    "@types/gapi.auth2": "0.0.46",
    "@types/gapi.youtube": "3.0.34",
    "@types/jasmine": "~2.8.3",
    "@types/jasminewd2": "~2.0.2",
    "@types/node": "12.12.54",
    "bootstrap-sass": "3.3.7",
    "cross-env": "^10.1.0",
    "jasmine-core": "~2.8.0",
    "jasmine-spec-reporter": "~4.2.1",
    "karma": "~2.0.0",
    "karma-chrome-launcher": "~2.2.0",
    "karma-jasmine": "~1.1.0",
    "karma-jasmine-html-reporter": "^0.2.2",
    "karma-spec-reporter": "0.0.32",
    "ngrx-action-creator-factory": "0.0.1",
    "ngrx-store-localstorage": "^9.0.0",
    "ngx-infinite-scroll": "9.0.0",
    "ngx-typeahead": "9.2.0",
    "ngx-youtube-player": "9.1.0",
    "prettier": "1.11.1",
    "rimraf": "2.6.1",
    "shx": "0.2.2",
    "tslint": "~5.9.1",
    "typescript": "~3.8.0",
    "websocket-driver": "^0.7.4"
  }
}
